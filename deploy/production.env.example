NIASSIST_ENV=production
NIASSIST_DATA_DIR=/var/lib/niassist
NIASSIST_DATABASE=/var/lib/niassist/chats.sqlite3
NIASSIST_TRUSTED_HOSTS=YOUR_DOMAIN,127.0.0.1,localhost
NIASSIST_PROXY_HOPS=1
COOKIE_SECURE=1
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_MODEL=gemini-2.5-flash
# Keep /var/lib/niassist/session-secret, or provide the SAME SECRET_KEY used before.
# Do not rotate it during migration unless invalidating sessions is intentional.
