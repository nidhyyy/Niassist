[Unit]
Description=Niassist document and reminder worker
After=niassist-web.service

[Service]
Type=simple
User=niassist
Group=niassist
WorkingDirectory=/opt/niassist/current
EnvironmentFile=/etc/niassist/niassist.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/niassist/current/.venv/bin/python worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/niassist
RestrictAddressFamilies=AF_UNIX
MemoryMax=1G

[Install]
WantedBy=multi-user.target
